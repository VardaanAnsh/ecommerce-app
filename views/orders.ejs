<%- include('./partials/header') %>

<div class="w-full min-h-screen px-20 py-16">

    <a href="/account"
       class="text-blue-600 hover:underline text-sm gap-4">
        ← Back to Account
    </a>
    <br>
    <h1 class="text-3xl font-semibold mb-8">
        My Orders
    </h1>

    <% if (orders.length === 0) { %>

        <p class="text-gray-500">
            You haven't placed any orders yet.
        </p>

    <% } else { %>

        <div class="flex flex-col gap-6">

            <% orders.forEach(order => { %>

                <div class="border rounded-lg p-6 shadow-sm">

                    <div class="flex justify-between mb-4">

                        <div>
                            <h2 class="text-xl font-semibold">
                                Order #<%= order._id %>
                            </h2>

                            <p class="text-gray-500">
                                <%= order.createdAt.toLocaleDateString() %>
                            </p>
                        </div>

                        <div>
                            <span class="px-3 py-1 rounded-full bg-gray-100">
                                <%= order.status %>
                            </span>
                        </div>

                    </div>

                    <% order.items.forEach(item => { %>

                        <div class="flex justify-between border-t py-3">

                            <div>
                                <h3 class="font-medium">
                                    <%= item.name %>
                                </h3>

                                <p class="text-gray-500">
                                    ₹ <%= item.price %> × <%= item.quantity %>
                                </p>
                            </div>

                            <div>
                                ₹ <%= (item.price * item.quantity) - item.discount %>
                            </div>

                        </div>

                    <% }) %>

                    <div class="border-t pt-4 mt-2 flex justify-between">

                        <h3 class="font-semibold">
                            Total Amount
                        </h3>

                        <h3 class="font-semibold text-green-600">
                            ₹ <%= order.totalAmount %>
                        </h3>

                    </div>

                    <div class="mt-5 flex justify-end">
                    <a href="/orders/<%= order._id %>"
                    class="text-blue-600 hover:underline text-sm">
                        View Details →
                    </a>
                </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>

<%- include('./partials/footer') %>