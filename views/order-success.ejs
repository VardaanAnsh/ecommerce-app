<%- include('./partials/header') %>

<div class="w-full min-h-screen bg-gray-50 px-6 md:px-12 lg:px-20 py-16">

    <div class="max-w-2xl mx-auto">

        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-10 text-center">

            <div class="w-20 h-20 mx-auto rounded-full bg-green-100 flex items-center justify-center">
                <span class="text-5xl text-green-600">
                    ✓
                </span>
            </div>

            <h1 class="text-3xl font-semibold text-gray-900 mt-6">
                Order Placed Successfully!
            </h1>

            <p class="text-gray-500 mt-3">
                Thank you for shopping with us.
            </p>

            <div class="border-t border-gray-200 mt-8 pt-6">

                <p class="text-sm text-gray-500">
                    Order ID
                </p>

                <p class="font-medium text-gray-900 mt-1 break-all">
                    #<%= order._id %>
                </p>

                <div class="flex justify-between mt-6 text-gray-600">
                    <span>
                        Total Amount
                    </span>

                    <span class="font-semibold text-gray-900">
                        ₹ <%= order.totalAmount %>
                    </span>
                </div>

                <div class="flex justify-between mt-3 text-gray-600">
                    <span>
                        Status
                    </span>

                    <span class="capitalize">
                        <%= order.status %>
                    </span>
                </div>

            </div>

            <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">

                <a
                    href="/orders/<%= order._id %>"
                    class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition">
                    View Order
                </a>

                <a
                    href="/shop"
                    class="border border-gray-300 px-6 py-3 rounded-lg font-semibold hover:bg-gray-50 transition">
                    Continue Shopping
                </a>

            </div>

        </div>

    </div>

</div>

<%- include('./partials/footer') %>