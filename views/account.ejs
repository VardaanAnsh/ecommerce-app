<%- include('./partials/header') %>

<div class="w-full min-h-screen bg-gray-50 px-6 md:px-12 lg:px-20 py-12">

    <!-- Header -->

    <div class="max-w-7xl mx-auto mb-10">

        <h1 class="text-4xl font-semibold text-gray-900">
            My Account
        </h1>

        <p class="text-gray-500 mt-2 text-lg">
            Hello, <%= user.fullname %>
        </p>

    </div>


    <!-- Account Options -->

    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-5">


        <!-- Orders -->

        <a href="/orders"
           class="bg-white border border-gray-200 rounded-xl p-7 shadow-sm hover:shadow-md transition duration-200 min-h-[150px] flex flex-col justify-center">

            <div class="flex items-center gap-3">

                <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-xl">
                    📦
                </div>

                <h2 class="text-xl font-semibold text-gray-900">
                    My Orders
                </h2>

            </div>

            <p class="text-gray-500 mt-3">
                View and track your orders
            </p>

            <p class="text-blue-600 text-sm mt-4">
                View orders →
            </p>

        </a>


        <!-- Profile -->

        <a href="/profile"
           class="bg-white border border-gray-200 rounded-xl p-7 shadow-sm hover:shadow-md transition duration-200 min-h-[150px] flex flex-col justify-center">

            <div class="flex items-center gap-3">

                <div class="w-10 h-10 rounded-full bg-purple-50 flex items-center justify-center text-xl">
                    👤
                </div>

                <h2 class="text-xl font-semibold text-gray-900">
                    My Profile
                </h2>

            </div>

            <p class="text-gray-700 mt-3">
                <%= user.fullname %>
            </p>

            <p class="text-gray-500">
                <%= user.email %>
            </p>

            <p class="text-blue-600 text-sm mt-4">
                View or edit profile →

            </p>

        </a>


        <!-- Addresses -->

        <div class="bg-white border border-gray-200 rounded-xl p-7 shadow-sm min-h-[150px] flex flex-col justify-center">

            <div class="flex items-center gap-3">

                <div class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center text-xl">
                    📍
                </div>

                <h2 class="text-xl font-semibold text-gray-900">
                    Addresses
                </h2>

            </div>

            <p class="text-gray-500 mt-3">
                Manage your delivery addresses
            </p>

            <a href="/addresses"
            class="inline-block mt-4 text-blue-600 hover:underline">
                Manage Addresses →
            </a>

        </div>


        <!-- Wishlist -->

        <div class="bg-white border border-gray-200 rounded-xl p-7 shadow-sm min-h-[150px] flex flex-col justify-center">

            <div class="flex items-center gap-3">

                <div class="w-10 h-10 rounded-full bg-pink-50 flex items-center justify-center text-xl">
                    ❤️
                </div>

                <h2 class="text-xl font-semibold text-gray-900">
                    Wishlist
                </h2>

            </div>

            <p class="text-gray-500 mt-3">
                View your saved products
            </p>

            <p class="text-sm text-gray-400 mt-4">
                Coming soon
            </p>

        </div>


        <!-- Payment Methods -->

        <div class="bg-white border border-gray-200 rounded-xl p-7 shadow-sm min-h-[150px] flex flex-col justify-center">

            <div class="flex items-center gap-3">

                <div class="w-10 h-10 rounded-full bg-green-50 flex items-center justify-center text-xl">
                    💳
                </div>

                <h2 class="text-xl font-semibold text-gray-900">
                    Payment Methods
                </h2>

            </div>

            <p class="text-gray-500 mt-3">
                Manage your payment methods
            </p>

            <p class="text-sm text-gray-400 mt-4">
                Coming soon
            </p>

        </div>


        <!-- Notifications -->

        <div class="bg-white border border-gray-200 rounded-xl p-7 shadow-sm min-h-[150px] flex flex-col justify-center">

            <div class="flex items-center gap-3">

                <div class="w-10 h-10 rounded-full bg-yellow-50 flex items-center justify-center text-xl">
                    🔔
                </div>

                <h2 class="text-xl font-semibold text-gray-900">
                    Notifications
                </h2>

            </div>

            <p class="text-gray-500 mt-3">
                Manage notification preferences
            </p>

            <p class="text-sm text-gray-400 mt-4">
                Coming soon
            </p>

        </div>

    </div>


    <!-- Recent Orders -->

    <div class="max-w-7xl mx-auto bg-white border border-gray-200 rounded-xl p-7 mt-8 shadow-sm">

        <div class="flex justify-between items-center">

            <div>

                <h2 class="text-2xl font-semibold text-gray-900">
                    Recent Orders
                </h2>

                <p class="text-gray-500 text-sm mt-1">
                    Your latest purchases
                </p>

            </div>

            <a href="/orders"
               class="text-blue-600 hover:underline text-sm font-medium">
                View All →
            </a>

        </div>


        <% if (orders.length === 0) { %>

            <div class="py-10 text-center">

                <p class="text-gray-500">
                    You haven't placed any orders yet.
                </p>

                <a href="/shop"
                   class="inline-block mt-4 text-blue-600 hover:underline">
                    Start Shopping →
                </a>

            </div>

        <% } else { %>

            <div class="mt-6 flex flex-col gap-3">

                <% orders.forEach(order => { %>

                    <div class="border border-gray-200 rounded-lg p-5 flex flex-col md:flex-row md:justify-between md:items-center gap-4 hover:bg-gray-50 transition">

                        <div>

                            <p class="font-medium text-gray-900">
                                Order #<%= order._id %>
                            </p>

                            <p class="text-sm text-gray-500 mt-1">
                                Placed on <%= order.createdAt.toLocaleDateString() %>
                            </p>

                        </div>


                        <div class="flex items-center justify-between md:justify-end gap-8">

                            <div>

                                <p class="font-semibold text-gray-900">
                                    ₹ <%= order.totalAmount %>
                                </p>

                                <p class="text-sm text-gray-500 capitalize mt-1">
                                    <%= order.status %>
                                </p>

                            </div>

                            <a href="/orders/<%= order._id %>"
                               class="text-blue-600 text-sm hover:underline">
                                View Details →
                            </a>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>


    <!-- Logout -->

    <div class="max-w-7xl mx-auto mt-8 pb-10">

        <a href="/users/logout"
           class="text-red-600 hover:text-red-700 font-medium">
            Logout
        </a>

    </div>

</div>

<%- include('./partials/footer') %>