<%- include('./partials/header') %>

<div class="w-full min-h-screen bg-gray-50 px-6 md:px-12 lg:px-20 py-12">

    <div class="max-w-6xl mx-auto">

        <!-- Header -->

        <div class="mb-8">

            <a href="/account"
               class="text-blue-600 hover:underline text-sm">
                ← Back to Account
            </a>

            <div class="flex flex-col md:flex-row md:justify-between md:items-center mt-5 gap-4">

                <div>

                    <h1 class="text-3xl font-semibold text-gray-900">
                        Order Details
                    </h1>

                    <p class="text-gray-500 mt-2">
                        Order #<%= order._id %>
                    </p>

                </div>

                <div>

                    <span class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 capitalize">
                        <%= order.status %>
                    </span>

                </div>

            </div>

        </div>


        <!-- Order Information -->

        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm mb-6">

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                <div>

                    <p class="text-sm text-gray-500">
                        Order Date
                    </p>

                    <p class="font-medium mt-1">
                        <%= order.createdAt.toLocaleDateString() %>
                    </p>

                </div>

                <div>

                    <p class="text-sm text-gray-500">
                        Order Status
                    </p>

                    <p class="font-medium mt-1 capitalize">
                        <%= order.status %>
                    </p>

                </div>

                <div>

                    <p class="text-sm text-gray-500">
                        Total Amount
                    </p>

                    <p class="font-semibold text-green-600 mt-1">
                        ₹ <%= order.totalAmount %>
                    </p>

                </div>

            </div>

        </div>


        <!-- Products -->

        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">

            <h2 class="text-2xl font-semibold text-gray-900 mb-6">
                Items in this Order
            </h2>


            <div class="flex flex-col">

                <% order.items.forEach((item, index) => { %>

                    <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 py-5 <%= index !== order.items.length - 1 ? 'border-b' : '' %>">

                        <div>

                            <h3 class="text-lg font-medium text-gray-900">
                                <%= item.name %>
                            </h3>

                            <p class="text-gray-500 mt-1">
                                ₹ <%= item.price %> × <%= item.quantity %>
                            </p>

                        </div>


                        <div class="text-right">

                            <p class="font-semibold">
                                ₹ <%= (item.price * item.quantity) - item.discount %>
                            </p>

                            <% if (item.discount > 0) { %>

                                <p class="text-sm text-green-600 mt-1">
                                    Discount: ₹ <%= item.discount %>
                                </p>

                            <% } %>

                        </div>

                    </div>

                <% }) %>

            </div>


            <!-- Total -->

            <div class="border-t mt-4 pt-5">

                <div class="flex justify-between items-center">

                    <h3 class="text-xl font-semibold">
                        Total Amount
                    </h3>

                    <h3 class="text-xl font-semibold text-green-600">
                        ₹ <%= order.totalAmount %>
                    </h3>

                </div>

            </div>

        </div>


        <!-- Actions -->

        <div class="mt-6 flex gap-4">

            <a href="/orders"
               class="px-5 py-3 border border-gray-300 rounded-lg hover:bg-white transition">
                View All Orders
            </a>

        </div>

    </div>

</div>

<%- include('./partials/footer') %>