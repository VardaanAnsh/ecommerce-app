<%- include('./partials/header') %>

<div class="w-full min-h-screen bg-gray-50 px-6 md:px-12 lg:px-20 py-12">

    <div class="max-w-6xl mx-auto">

        <!-- Back -->
        <a href="/orders"
           class="text-blue-600 hover:underline text-sm">
            ← Back to Orders
        </a>

        <!-- Header -->
        <div class="mt-6 bg-white border border-gray-200 rounded-xl p-6 shadow-sm">

            <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4">

                <div>
                    <p class="text-sm text-gray-500">
                        Order ID
                    </p>

                    <h1 class="text-2xl font-semibold text-gray-900 mt-1">
                        #<%= order._id %>
                    </h1>

                    <p class="text-gray-500 mt-2">
                        Placed on <%= order.createdAt.toLocaleDateString() %>
                    </p>
                </div>

                <div>
                    <span class="px-4 py-2 rounded-full bg-yellow-100 text-yellow-700 font-medium capitalize">
                        <%= order.status %>
                    </span>
                </div>

            </div>

        </div>


        <!-- Order Status -->
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm mt-6">

            <h2 class="text-xl font-semibold text-gray-900 mb-8">
                Order Status
            </h2>

            <div class="grid grid-cols-4 gap-4">

                <div class="text-center">
                    <div class="w-10 h-10 mx-auto rounded-full bg-green-100 text-green-600 flex items-center justify-center font-semibold">
                        ✓
                    </div>

                    <p class="font-medium mt-3">
                        Order Placed
                    </p>

                    <p class="text-sm text-gray-500 mt-1">
                        <%= order.createdAt.toLocaleDateString() %>
                    </p>
                </div>


                <div class="text-center">
                    <div class="w-10 h-10 mx-auto rounded-full
                        <%= ['confirmed','shipped','delivered'].includes(order.status)
                            ? 'bg-green-100 text-green-600'
                            : 'bg-gray-100 text-gray-400' %>
                        flex items-center justify-center font-semibold">

                        <%= ['confirmed','shipped','delivered'].includes(order.status) ? '✓' : '2' %>

                    </div>

                    <p class="font-medium mt-3">
                        Confirmed
                    </p>
                </div>


                <div class="text-center">
                    <div class="w-10 h-10 mx-auto rounded-full
                        <%= ['shipped','delivered'].includes(order.status)
                            ? 'bg-green-100 text-green-600'
                            : 'bg-gray-100 text-gray-400' %>
                        flex items-center justify-center font-semibold">

                        <%= ['shipped','delivered'].includes(order.status) ? '✓' : '3' %>

                    </div>

                    <p class="font-medium mt-3">
                        Shipped
                    </p>
                </div>


                <div class="text-center">
                    <div class="w-10 h-10 mx-auto rounded-full
                        <%= order.status === 'delivered'
                            ? 'bg-green-100 text-green-600'
                            : 'bg-gray-100 text-gray-400' %>
                        flex items-center justify-center font-semibold">

                        <%= order.status === 'delivered' ? '✓' : '4' %>

                    </div>

                    <p class="font-medium mt-3">
                        Delivered
                    </p>
                </div>

            </div>

        </div>


        <!-- Main Content -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">

            <!-- Left -->
            <div class="lg:col-span-2 space-y-6">

                <!-- Delivery Address -->
                <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">

                    <h2 class="text-xl font-semibold text-gray-900">
                        Delivery Address
                    </h2>

                    <div class="mt-5 border border-gray-200 rounded-lg p-5">

                        <div class="flex items-center gap-3">

                            <h3 class="font-semibold text-gray-900">
                                <%= order.shippingAddress.name %>
                            </h3>

                            <span class="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded-full">
                                <%= order.shippingAddress.label %>
                            </span>

                        </div>

                        <p class="text-gray-600 mt-3">
                            <%= order.shippingAddress.addressLine %>
                        </p>

                        <p class="text-gray-600">
                            <%= order.shippingAddress.city %>,
                            <%= order.shippingAddress.state %>
                            -
                            <%= order.shippingAddress.pincode %>
                        </p>

                        <p class="text-gray-600 mt-2">
                            Phone: <%= order.shippingAddress.phone %>
                        </p>

                    </div>

                </div>


                <!-- Items -->
                <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">

                    <h2 class="text-xl font-semibold text-gray-900 mb-5">
                        Items in this Order
                    </h2>

                    <div class="flex flex-col">

                        <% order.items.forEach((item, index) => { %>

                            <div class="flex justify-between gap-6 py-5
                                <%= index !== order.items.length - 1 ? 'border-b border-gray-200' : '' %>">

                                <div>

                                    <h3 class="font-medium text-gray-900">
                                        <%= item.name %>
                                    </h3>

                                    <p class="text-sm text-gray-500 mt-2">
                                        ₹ <%= item.price %>
                                        ×
                                        <%= item.quantity %>
                                    </p>

                                    <% if (item.discount > 0) { %>

                                        <p class="text-sm text-green-600 mt-1">
                                            Discount: ₹ <%= item.discount %> per item
                                        </p>

                                    <% } %>

                                </div>


                                <div class="text-right">

                                    <p class="font-semibold text-gray-900">
                                        ₹ <%= (item.price - item.discount) * item.quantity %>
                                    </p>

                                </div>

                            </div>

                        <% }) %>

                    </div>

                </div>

            </div>


            <!-- Right -->
            <div>

                <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm sticky top-6">

                    <h2 class="text-xl font-semibold text-gray-900">
                        Price Details
                    </h2>

                    <%
                        let subtotal = 0;
                        let totalDiscount = 0;

                        order.items.forEach(item => {
                            subtotal += item.price * item.quantity;
                            totalDiscount += item.discount * item.quantity;
                        });

                        const platformFee = order.items.length * 20;
                        const shippingFee = 0;
                    %>


                    <div class="mt-6 space-y-4">

                        <div class="flex justify-between text-gray-600">
                            <span>Subtotal</span>
                            <span>₹ <%= subtotal %></span>
                        </div>


                        <div class="flex justify-between text-green-600">
                            <span>Discount</span>
                            <span>- ₹ <%= totalDiscount %></span>
                        </div>


                        <div class="flex justify-between text-gray-600">
                            <span>Platform Fee</span>
                            <span>₹ <%= platformFee %></span>
                        </div>


                        <div class="flex justify-between text-gray-600">
                            <span>Shipping</span>
                            <span class="text-green-600">
                                FREE
                            </span>
                        </div>

                    </div>


                    <div class="border-t border-gray-200 mt-6 pt-5">

                        <div class="flex justify-between items-center">

                            <span class="text-lg font-semibold text-gray-900">
                                Total Amount
                            </span>

                            <span class="text-lg font-semibold text-green-600">
                                ₹ <%= order.totalAmount %>
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Actions -->
        <div class="mt-6 flex flex-wrap gap-4">

            <a href="/shop"
               class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium">
                Continue Shopping
            </a>

            <a href="/orders"
               class="px-6 py-3 border border-gray-300 bg-white rounded-lg hover:bg-gray-50 transition font-medium">
                View All Orders
            </a>

        </div>

    </div>

</div>

<%- include('./partials/footer') %>