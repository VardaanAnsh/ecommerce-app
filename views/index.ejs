<%- include('./partials/header') %>

<div class="w-full h-screen flex px-20">
  <!-- REGISTER SECTION -->
  <div class="w-1/2 flex items-center justify-center h-screen">
    <div class="w-full px-32">
      <h3 class="text-4xl">welcome to <span class="text-blue-400 font-semibold">Scatch</span></h3>
      <h4 class="text-2xl mb-5">create your account</h4>

      <!-- FLASH MESSAGES (Register Side) -->
      <% if (success && success.length > 0) { %>
        <div class="bg-green-500 text-white p-3 rounded-md mb-3">
          <% success.forEach(msg => { %>
            <p><%= msg %></p>
          <% }) %>
        </div>
      <% } %>

      <% if (error && error.length > 0) { %>
        <div class="bg-red-500 text-white p-3 rounded-md mb-3">
          <% error.forEach(msg => { %>
            <p><%= msg %></p>
          <% }) %>
        </div>
      <% } %>

      <form autocomplete="off" action="/users/register" method="post">
        <input
          class="bg-zinc-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
          type="text" placeholder="Full Name" name="fullname"
          value="<%= typeof formData !== 'undefined' && formData.fullname ? formData.fullname : '' %>"
        >
        <% if (typeof errorMessages !== 'undefined' && errorMessages.fullname) { %>
          <span class="text-red-500 text-sm"><%= errorMessages.fullname %></span>
        <% } %>

        <input
          class="bg-zinc-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
          type="email" placeholder="Email" name="email"
          value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
        >
        <% if (typeof errorMessages !== 'undefined' && errorMessages.email) { %>
          <span class="text-red-500 text-sm"><%= errorMessages.email %></span>
        <% } %>

        <input
          class="bg-zinc-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
          type="password" placeholder="Password" name="password"
          value="<%= typeof formData !== 'undefined' && formData.password ? formData.password : '' %>"
        >
        <% if (typeof errorMessages !== 'undefined' && errorMessages.password) { %>
          <span class="text-red-500 text-sm inline"><%= errorMessages.password %></span>
        <% } %>

        <input class="px-5 rounded-full py-3 mt-2 bg-blue-500 text-white block" type="submit" value="Create My Account">
      </form>
    </div>
  </div>

  <!-- LOGIN SECTION -->
  <div class="w-1/2 flex items-center justify-center h-screen">
    <div class="w-full px-32">
      <h4 class="text-2xl capitalize mb-5">login your account</h4>

      <!-- FLASH MESSAGES (Login Side) -->
      <% if (loginSuccess && loginSuccess.length > 0) { %>
        <div class="bg-green-500 text-white p-3 rounded-md mb-3">
          <% loginSuccess.forEach(msg => { %>
            <p><%= msg %></p>
          <% }) %>
        </div>
      <% } %>

      <% if (loginError && loginError.length > 0) { %>
        <div class="bg-red-500 text-white p-3 rounded-md mb-3">
          <% loginError.forEach(msg => { %>
            <p><%= msg %></p>
          <% }) %>
        </div>
      <% } %>

      <form autocomplete="off" action="/users/login" method="post">
        <input
          class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
          type="email" placeholder="Email" name="email">
        <input
          class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
          type="password" placeholder="Password" name="password">
        <input class="px-5 block rounded-full py-3 mt-2 bg-blue-500 text-white" type="submit" value="Login">
      </form>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>

<!-- Optional: Auto-hide flash messages -->
<script>
  setTimeout(() => {
    document.querySelectorAll('.bg-green-500, .bg-red-500').forEach(div => div.remove());
  }, 3000);
</script>